# Regenerated and committed nightly by refresh-schedule-index.yml, which
# decides whether to commit by byte-diffing this file with `git diff --quiet`.
# If Prettier reformats it, the generator writes its own formatting back on the
# next run, that job commits a formatting-only change every single night, and
# format:check fails on main in between. Must stay ignored.
public/schedule-index.json

# npm owns this.
package-lock.json

# Build output.
dist/
dist-server/

# Archival records of shipped work, kept as written.
docs/plans/

# Local state, untracked. Present only on a developer's machine, so formatting
# it would fail check runs for some people and not others.
.claude/
working-material/
