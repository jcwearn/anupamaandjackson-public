{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // oxlint's default is `correctness` at WARN, and warnings do not affect the
  // exit code -- so before this block, `npm run lint` was green no matter what
  // it printed. cf-worker-email shipped an unused catch binding that way.
  //
  // Everything here is `error` or `off`, never `warn`. A rule nobody will act
  // on is noise, and noise is what hid that finding.
  //
  // Not enabled: `pedantic` (its top rules here are no-inline-comments and
  // max-lines-per-function, which fight the house commenting style), plus
  // `perf`, `style`, `restriction` and `nursery`.
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },

  // NOTE: `plugins` REPLACES oxlint's base set rather than adding to it, so
  // this list silently drops `unicorn`, which is on by default. That is
  // currently deliberate: restoring it adds 145 findings across the fleet,
  // 93 of them unicorn(no-array-sort) wanting .toSorted() instead of .sort().
  // That is a behavioural change to mutation semantics and belongs in its own
  // PR, not in a change about severity.
  "plugins": ["react", "typescript", "oxc"],

  "ignorePatterns": ["dist", "dist-server"],

  "rules": {
    "react/rules-of-hooks": "error",

    // Obsolete under the modern JSX transform: these repos compile with
    // `jsx: react-jsx`, so React need not be in scope. It is the one rule
    // turned off rather than enforced, and it is off because it is wrong here
    // -- 664 false positives across the fleet, 295 in a single repo.
    "react/react-in-jsx-scope": "off",

    // Promoted from `warn`. allowConstantExport keeps plain constant exports
    // legal, so only the real cases fail: a cva() call or a React context
    // exported beside a component, either of which breaks fast refresh.
    "react/only-export-components": ["error", { "allowConstantExport": true }],

    // Off because its model of an "extra" dependency has no room for the one
    // this repo leans on: a dep listed purely to re-run the effect, not because
    // the body reads it. useNavItems re-reads localStorage on `pathname` so a
    // nav that survives client-side navigation notices a flag set after it
    // mounted; JumpNav keys on `jump` so a second jump does not yank the spacer
    // out from under a scroll still in flight; WhatToWear waits on `status` and
    // `events` for the anchor to exist at all, since it only appears once the
    // guest's schedule is decrypted. Delete those deps to satisfy the rule and
    // all three features quietly stop working. eslint's exhaustive-deps allows
    // extra deps for exactly this reason; this rule does not, and takes no
    // options, so "off" is the only lever. The comments at each of the three
    // sites say what the dep is for -- read them before adding a fourth.
    "react/exhaustive-effect-dependencies": "off",

    // A naming preference rather than a defect, and it fights a universal
    // convention: scripts/prerender.js reconstructs `__dirname` from
    // import.meta.url, which is how every ESM file in Node spells it.
    // Renaming it would make the code read worse to satisfy a style rule.
    // TypeScript has `private` for what this approximates.
    "eslint/no-underscore-dangle": "off"
  }
}
